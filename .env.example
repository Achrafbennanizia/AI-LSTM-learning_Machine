# Kopieren nach `.env` und anpassen (`.env` wird nicht ins Git eingecheckt).
# ─── Slurm / HiPer (für generiertes job_research.slurm) ──────────────────────
SLURM_PARTITION=compute
SLURM_ACCOUNT=YOUR_SLURM_PROJECT_ACCOUNT
SLURM_MAIL_USER=your.email@uni.example
SLURM_MAIL_TYPE=END,FAIL
SLURM_TIME_LIMIT=02:00:00
SLURM_MEM=16G
SLURM_CPUS_PER_TASK=4
SLURM_GRES=gpu:1g.5gb:1
SLURM_JOB_ACCOUNT_FALLBACK=

# Fallback für JR_ACC innerhalb des Scripts, wenn $SLURM_JOB_ACCOUNT beim srun fehlt
# (leer lassen → nutzt automatisch SLURM_ACCOUNT)

# ─── Daten / Pfade (optional; Standard in job_research.slurm: data/leo_sessions_v3.csv)
# GUITARAI_DATA=/abs/path/to/leo_sessions_v3.csv
# GUITARAI_DATA_DIR=/abs/path/to/data_dir
